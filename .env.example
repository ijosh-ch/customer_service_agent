# OpenAI API key — only needed if NOT using the DGX Spark local LLM
# Leave as-is or remove when using Nemotron on 140.118.122.123
OPENAI_API_KEY=your_openai_api_key_here

# ── DGX Spark LLM (primary — replaces OpenAI, no per-token cost) ─────────────
# Endpoint: NVIDIA Nemotron Super 49B FP8 served on the DGX Spark
# Share these three lines with teammates — add to their .env file
DGX_SPARK_URL=http://140.118.122.123:8090/v1
DGX_MODEL=nemotron-super-fp8
DGX_API_KEY=llm-final-project-1-2

# Remote MySQL — Lab server (default)
DB_HOST=140.118.122.119
DB_PORT=3306
DB_USER=llm-student
DB_PASSWORD=llm12345
DB_NAME=llm-course

# Local MySQL (alternative — uncomment and replace DB_* above to use)
# DATABASE_URL=localhost
# DATABASE_USER=root
# DATABASE_PASSWORD=12345678
# DATABASE_NAME=customer_service

# Google Cloud OAuth 2.0 (Project 2 — download JSON from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your_client_secret
OAUTHLIB_INSECURE_TRANSPORT=1

# Test email sender (Project 2 — used by the "Seed Gmail Inbox" cell in LLM project 2.ipynb)
# SENDER: any Gmail account with an App Password enabled (myaccount.google.com/apppasswords)
# TARGET: the Gmail inbox the Refund Agent monitors (same account used for OAuth above)
TEST_SENDER_EMAIL=your_test_sender@gmail.com
TEST_SENDER_APP_PASSWORD=xxxx xxxx xxxx xxxx
TEST_TARGET_EMAIL=your_agent_inbox@gmail.com
